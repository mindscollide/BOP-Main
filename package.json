{
  "name": "my-appvite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "clean": "rmdir /s /q node_modules\\.vite && rmdir /s /q dist",
    "start:dealer": "env-cmd -f .env.dealer vite",
    "start:corporate": "env-cmd -f .env.corporate vite",
    "start:branch": "env-cmd -f .env.branch vite",
    "start:treasury": "env-cmd -f .env.treasury vite",
    "build:dealer": "npm run clean && env-cmd -f .env.dealer vite build",
    "build:corporate": "npm run clean && env-cmd -f .env.corporate vite build",
    "build:branch": "npm run clean && env-cmd -f .env.branch vite build",
    "build:treasury": "npm run clean && env-cmd -f .env.treasury vite build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/montserrat": "^5.0.18",
    "@fontsource/poppins": "^5.0.14",
    "@fontsource/roboto": "^5.0.14",
    "@mui/material": "^7.3.1",
    "@mui/styles": "^6.5.0",
    "@reduxjs/toolkit": "^2.2.7",
    "antd": "^5.20.1",
    "axios": "^1.7.7",
    "bootstrap": "^5.3.3",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.18.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "paho-mqtt": "^1.1.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.3.1",
    "react-multi-date-picker": "^4.5.2",
    "react-number-format": "^5.4.4",
    "react-otp-input": "^3.1.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.0",
    "react-select": "^5.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "vite": "^6.3.2"
  }
}
